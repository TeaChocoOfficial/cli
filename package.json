{
    "name": "@teachoco-dev/cli",
    "version": "0.0.10",
    "type": "commonjs",
    "description": "javascript npm library create by teachoco-official",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "bin": {
        "tcc": "./dist/command.js"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "tcc": "tsx src/command.ts",
        "start": "node dist/command.js",
        "prepare": "npm run build",
        "build": "rimraf ./dist && rollup -c",
        "dev": "rimraf ./dist && rollup -c -w",
        "public": "npm publish --scope=@teachoco-dev --access=public --no-git-checks",
        "publicforce": "npm publish --scope=@teachoco-dev --access=public --force --no-git-checks"
    },
    "keywords": [
        "cli",
        "generator",
        "structure"
    ],
    "author": "teachoco-official",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TeaChocoOfficial/cli.git"
    },
    "peerDependencies": {
        "chokidar": "^4.0.3",
        "commander": "^13.1.0",
        "fs-extra": "^11.3.0"
    },
    "dependencies": {
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@typescript-eslint/parser": "^8.59.2",
        "chal": "0.0.1-security.0",
        "chalk": "^5.6.2",
        "chokidar": "^5.0.0",
        "commander": "^14.0.3",
        "dayjs": "^1.11.20",
        "diff": "^9.0.0",
        "fs-extra": "^11.3.5",
        "gulp": "^5.0.1",
        "gulp-chmod": "^4.0.0",
        "gulp-insert": "^0.5.0",
        "js-yaml": "^4.1.1",
        "prettier": "^3.8.3",
        "react": "^19.2.6",
        "recoil": "^0.7.7",
        "rollup": "^4.60.3",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "tslib": "^2.8.1",
        "tsx": "^4.21.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/diff": "^8.0.0",
        "@types/fs-extra": "^11.0.4",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^25.6.2",
        "@types/react": "^19.2.14",
        "eslint": "^10.3.0",
        "globals": "^17.6.0",
        "rimraf": "^6.1.3",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3"
    }
}