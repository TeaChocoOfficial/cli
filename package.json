{
    "name": "@teachoco-dev/cli",
    "version": "0.0.5",
    "type": "commonjs",
    "description": "javascript npm library create by teachoco-official",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "bin": {
        "tcc": "./dist/command.js"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "tcc": "tsx src/command.ts",
        "start": "node dist/command.js",
        "prepare": "pnpm run build",
        "build": "rimraf ./dist && rollup -c",
        "dev": "rimraf ./dist && rollup -c -w",
        "public": "pnpm publish --scope=@teachoco-dev --access=public",
        "publicforce": "pnpm publish --scope=@teachoco-dev --access=public --force"
    },
    "keywords": [
        "cli",
        "generator",
        "structure"
    ],
    "author": "teachoco-official",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TeaChocoOfficial/cli.git"
    },
    "peerDependencies": {
        "chokidar": "^4.0.3",
        "commander": "^13.1.0",
        "fs-extra": "^11.3.0"
    },
    "dependencies": {
        "@rollup/plugin-commonjs": "^28.0.2",
        "@rollup/plugin-node-resolve": "^16.0.0",
        "@rollup/plugin-typescript": "^12.1.2",
        "chal": "0.0.1-security.0",
        "chalk": "^5.4.1",
        "chokidar": "^4.0.3",
        "commander": "^13.1.0",
        "dayjs": "^1.11.13",
        "diff": "^7.0.0",
        "fs-extra": "^11.3.0",
        "gulp": "^5.0.1",
        "gulp-chmod": "^4.0.0",
        "gulp-insert": "^0.5.0",
        "js-yaml": "^4.1.0",
        "prettier": "^3.4.2",
        "react": "^19.1.0",
        "recoil": "^0.7.7",
        "rollup": "^4.29.1",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "tslib": "^2.8.1",
        "tsx": "^4.19.3"
    },
    "devDependencies": {
        "@types/diff": "^8.0.0",
        "@types/fs-extra": "^11.0.4",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.13.10",
        "@types/react": "^19.1.8",
        "rimraf": "^6.0.1",
        "tslib": "^2.8.1",
        "typescript": "^5.7.2"
    }
}