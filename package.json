        "prettier": "^3.8.3",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-editor-js": "^2.1.0",
        "react-hot-toast": "^2.6.0",
        "react-i18next": "^17.0.7",
        "react-icons": "^5.6.0",
        "react-router-dom": "^7.15.0",
