{
    "name": "@teachoco-dev/cli",
    "version": "0.0.11-beta",
    "type": "commonjs",
    "description": "javascript npm library create by teachoco-official",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "bin": {
        "tcc": "dist/command.js"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "scripts": {
        "tcc": "tsx src/command.ts",
        "start": "node dist/command.js",
        "prepare": "npm run build",
        "build": "rimraf ./dist && rollup -c && node -e \"require('fs-extra').copySync('./ui', './dist/ui')\"",
        "dev": "rimraf ./dist && rollup -c -w",
        "public": "npm publish --scope=@teachoco-dev --access=public --no-git-checks",
        "publicforce": "npm publish --scope=@teachoco-dev --access=public --force --no-git-checks"
    },
    "keywords": [
        "cli",
        "generator",
        "structure"
    ],
    "author": "teachoco-official",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/TeaChocoOfficial/cli.git"
    },
    "peerDependencies": {
        "chokidar": "^5.0.0",
        "commander": "^13.1.0",
        "fs-extra": "^11.3.0"
    },
    "dependencies": {
        "@editorjs/code": "^2.9.4",
        "@editorjs/delimiter": "^1.4.2",
        "@editorjs/editorjs": "^2.31.6",
        "@editorjs/header": "^2.8.8",
        "@editorjs/image": "^2.10.3",
        "@editorjs/inline-code": "^1.5.2",
        "@editorjs/list": "^2.0.9",
        "@editorjs/paragraph": "^2.11.7",
        "@editorjs/quote": "^2.7.6",
        "@editorjs/table": "^2.4.5",
        "@editorjs/warning": "^1.4.1",
        "@monaco-editor/react": "^4.7.0",
        "@react-editor-js/client": "^2.1.0",
        "@react-editor-js/core": "^2.1.0",
        "@rollup/plugin-commonjs": "^29.0.2",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-typescript": "^12.3.0",
        "@tailwindcss/vite": "^4.3.0",
        "@typescript-eslint/parser": "^8.59.2",
        "@vitejs/plugin-react": "^6.0.1",
        "axios": "^1.16.0",
        "chalk": "^4.1.2",
        "chokidar": "^5.0.0",
        "commander": "^14.0.3",
        "dayjs": "^1.11.20",
        "diff": "^9.0.0",
        "dockview": "^6.0.7",
        "dockview-react": "^6.0.7",
