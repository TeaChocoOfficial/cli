{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Structure Config",
    "type": "object",
    "properties": {
        "workspaces": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "run": {
                        "type": "string"
                    },
                    "pack": {
                        "type": "object"
                    },
                    "src": {
                        "type": "array",
                        "items": {
                            "type": "object"
                        }
                    }
                }
            }
        }
    }
}